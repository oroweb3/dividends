# Required: public App ID from your dedicated Dividends by Oro app in dashboard.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: only if using a specific Privy app client.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# GOLD output mint.
ORO_GOLD_MINT=

# Server-only Phase 2 credentials
PRIVY_APP_SECRET=
SOLANA_RPC_URL=
SUPABASE_PROJECT_ID=
# Optional override for the derived https://<project-id>.supabase.co URL
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy provider; unused by active Titan integration.
JUPITER_API_KEY=
# Random >=32-character secret binding short-lived previews to a user and wallet
SWAP_PREVIEW_SECRET=

# Active server-only quote provider (Jupiter key may remain unused)
TITAN_AUTH_TOKEN=
TITAN_WS_URL=

# Delegation setup and server signing.
# Create a dedicated authorization key for this app in Privy.
# Keep the private key server-only; never prefix it NEXT_PUBLIC_.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Key quorum ID returned with the authorization key.
PRIVY_SIGNER_ID=
# Restricted Solana signer policy; never attach a signer with empty policies.
PRIVY_SIGNER_POLICY_ID=

# Keep false until funded end-to-end validation is complete.
DIVIDEND_EXECUTION_ENABLED=false
# Authenticate the bounded background-processing endpoint; generated locally.
DIVIDEND_JOB_SECRET=
# Used by scripts/run-dividend-job.cjs; use HTTPS for deployed instances.
DIVIDEND_APP_URL=http://127.0.0.1:3000

PRIVY_SPONSOR_AUTHORIZATION_PRIVATE_KEY=

PRIVY_SPONSOR_OWNER_ID=

PRIVY_SPONSOR_WALLET_ID=

PRIVY_SPONSOR_WALLET_ADDRESS=

PRIVY_SPONSOR_POLICY_ID=

# Vercel cron authorization; random >=32 characters, production only.
CRON_SECRET=
